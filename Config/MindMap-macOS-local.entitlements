<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local (ad-hoc, "Sign to Run Locally") macOS builds when no team provisioning
	     profile is available (Tools/xcb/xcb.sh fallback): no iCloud/CloudKit, no push,
	     no shared keychain group. The app shows "iCloud Sync unavailable". -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
